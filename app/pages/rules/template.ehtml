import "./style.css";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Account, Category, CategoryKind, Rule, Transaction, isCategorized } from "#app/shared/lib/ledger";
import { seriesColor } from "#app/shared/lib/colors";
import { applyRules } from "#app/shared/services/ledger";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect, NativeSelectOptGroup } from "@elements/ui/native-select";
import { Icon } from "@elements/ui/icon";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";

interface RuleDraft {
  pattern: string;
  categoryId: string;
  search: string;
  error: string;
  applied: string;
}

interface CategoryDraft {
  name: string;
  kind: CategoryKind;
  error: string;
}

const GROUPS: { id: CategoryKind; label: string }[] = [
  { id: "expense", label: "Spending" },
  { id: "income", label: "Income" },
  { id: "transfer", label: "Transfers" },
];

function sorted(categories: LiveView<Category>, kind: CategoryKind): Category[] {
  return categories.filter((c) => c.kind === kind).sort((a, b) => a.name.localeCompare(b.name));
}

function visibleRules(rules: LiveView<Rule>, categories: LiveView<Category>, search: string): Rule[] {
  let q = search.trim().toLowerCase();

  return rules
    .filter((r) => q === "" || r.pattern.includes(q) || (categories.get(r.categoryId)?.name.toLowerCase().includes(q) ?? false))
    .sort((a, b) => a.pattern.localeCompare(b.pattern));
}

function matchCount(transactions: LiveView<Transaction>, rule: Rule): number {
  return transactions.filter((t) => t.description.toLowerCase().includes(rule.pattern)).length;
}

function uncategorized(transactions: LiveView<Transaction>): number {
  return transactions.filter((t) => !isCategorized(t)).length;
}

export function waitingFor(transactions: LiveView<Transaction>, rules: LiveView<Rule>): number {
  return transactions.filter((t) => !isCategorized(t) && rules.some((r) => t.description.toLowerCase().includes(r.pattern))).length;
}

function usage(transactions: LiveView<Transaction>, category: Category): number {
  let n = 0;

  for (let t of transactions) {
    if (t.categoryId === category.id || t.splits?.some((p) => p.categoryId === category.id)) {
      n++;
    }
  }

  return n;
}

function onAddRule(rules: LiveView<Rule>, draft: RuleDraft) {
  draft.error = "";

  if (draft.pattern.trim().length < 2) {
    draft.error = "a rule needs at least two characters to match";
    return;
  }

  if (!draft.categoryId) {
    draft.error = "choose the category it files into";
    return;
  }

  try {
    rules.insert(
      { pattern: draft.pattern.trim().toLowerCase(), categoryId: draft.categoryId, createdAt: new Date() },
      () => draft.pattern = "",
    );
  } catch (err: any) {
    draft.error = err.message;
  }
}

function onRuleCategory(rules: LiveView<Rule>, rule: Rule, categoryId: string) {
  rules.update({ ...rule, categoryId });
}

function onApply(draft: RuleDraft) {
  let n = applyRules();
  draft.applied = n === 0 ? "No uncategorized transactions matched a rule." : `Categorized ${n} ${n === 1 ? "transaction" : "transactions"}.`;
}

function onAddCategory(categories: LiveView<Category>, draft: CategoryDraft) {
  draft.error = "";

  if (draft.name.trim() === "") {
    draft.error = "give the category a name";
    return;
  }

  try {
    categories.insert({ name: draft.name.trim(), kind: draft.kind, colorSlot: null }, () => draft.name = "");
  } catch (err: any) {
    draft.error = err.message;
  }
}

function deleteMessage(count: number): string {
  return count > 0 ? `Its ${count} transactions become uncategorized, and its rules and budget go too.` : "";
}

<html lang="en" class="page-rules" (
  accounts: LiveView<Account>,
  categories: LiveView<Category>,
  transactions: LiveView<Transaction>,
  rules: LiveView<Rule>,
  private draft: RuleDraft = { pattern: "", categoryId: "", search: "", error: "", applied: "" },
  private categoryDraft: CategoryDraft = { name: "", kind: "expense" as CategoryKind, error: "" },
)>
  <head>
    <title>Rules · thriftledger</title>
    <meta name="description" content="Rules that categorize transactions by description, and your categories.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="/rules">
      <div class="stack is-xl">
        <div class="stack is-xs">
          <h1>Rules</h1>
          <p class="lede">A rule files every transaction whose description contains its text. The longest match wins, so "hollow oak" beats "oak".</p>
        </div>

        <div class="rules-grid">
          <div class="stack is-lg">
            <Card title="New rule" level={2}>
              <CardContent>
                <form class="stack is-sm" onsubmit={() => onAddRule(rules, draft)}>
                  <div class="rule-add">
                    <Field label="Description contains" reserveError={false}>
                      <Input value={draft.pattern} placeholder="fernleaf market" attrs={{ autocapitalize: "none", spellcheck: "false" }} />
                    </Field>
                    <Field label="File it under" reserveError={false}>
                      <NativeSelect block value={draft.categoryId} placeholder="Choose…">
                        <NativeSelectOptGroup e:for={group of GROUPS} label={group.label}>
                          <option e:for={c of sorted(categories, group.id)} value={c.id}>{c.name}</option>
                        </NativeSelectOptGroup>
                      </NativeSelect>
                    </Field>
                    <Button type="submit" variant="primary">Add rule</Button>
                  </div>
                  <p e:if={draft.error} class="error">{draft.error}</p>
                  <p e:else class="hint">New rules also categorize the matching transactions already waiting.</p>
                </form>
              </CardContent>
            </Card>

            <Card title={`${rules.length} rules`} level={2}>
              <CardAction slot="action">
                <div class="row is-sm">
                  <span class="hint" e:if={draft.applied}>{draft.applied}</span>
                  <Button size="sm" disabled={waitingFor(transactions, rules) === 0} onclick={() => onApply(draft)}>
                    Apply to {waitingFor(transactions, rules)} uncategorized
                  </Button>
                </div>
              </CardAction>

              <div class="rule-search">
                <Input type="search" size="sm" value={draft.search} placeholder="Filter rules" attrs={{ "aria-label": "Filter rules" }} />
              </div>

              <ul class="rule-list">
                <li e:for={rule of visibleRules(rules, categories, draft.search)} class="rule-row">
                  <span class="rule-pattern" title={rule.pattern}>{rule.pattern}</span>
                  <svg class="rule-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8 H12 M9 5 L12 8 L9 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <NativeSelect size="sm"
                                block
                                value={rule.categoryId}
                                attrs={{ "aria-label": `Category for ${rule.pattern}` }}
                                onchange={(e) => onRuleCategory(rules, rule, (e.target as HTMLSelectElement).value)}>
                    <NativeSelectOptGroup e:for={group of GROUPS} label={group.label}>
                      <option e:for={c of sorted(categories, group.id)} value={c.id}>{c.name}</option>
                    </NativeSelectOptGroup>
                  </NativeSelect>
                  <span class="rule-count">{matchCount(transactions, rule)} {matchCount(transactions, rule) === 1 ? "match" : "matches"}</span>
                  <Button variant="ghost" size="sm" icon label={`Delete rule ${rule.pattern}`} onclick={() => rules.delete(rule)}>
                    <Icon name="x" />
                  </Button>
                </li>
              </ul>
            </Card>
          </div>

          <Card title="Categories" level={2}>
            <CardAction slot="action" e:if={uncategorized(transactions) > 0}>
              <a class="hint" href="/transactions?show=uncategorized">{uncategorized(transactions)} uncategorized</a>
            </CardAction>

            <div e:for={group of GROUPS} class="cat-group">
              <h3>{group.label}</h3>
              <ul class="cat-list">
                <li e:for={c of sorted(categories, group.id)} class="cat-row">
                  <span class="swatch" style={`background: ${seriesColor(c)}`}></span>
                  <span>{c.name}</span>
                  <small>{usage(transactions, c)}</small>
                  <AlertDialog title={`Delete ${c.name}?`} description={deleteMessage(usage(transactions, c))}>
                    <Button slot="trigger" variant="ghost" size="sm" icon label={`Delete ${c.name}`}>
                      <Icon name="x" />
                    </Button>
                    <AlertDialogFooter>
                      <AlertDialogCancel>Cancel</AlertDialogCancel>
                      <AlertDialogAction variant="danger" onclick={() => categories.delete(c)}>Delete</AlertDialogAction>
                    </AlertDialogFooter>
                  </AlertDialog>
                </li>
              </ul>
            </div>

            <CardFooter>
              <form class="cat-add" onsubmit={() => onAddCategory(categories, categoryDraft)}>
                <Input size="sm" value={categoryDraft.name} placeholder="New category" attrs={{ "aria-label": "New category name" }} />
                <NativeSelect size="sm" block value={categoryDraft.kind} attrs={{ "aria-label": "Kind" }} options={GROUPS.map((g) => ({ value: g.id, label: g.label }))} />
                <Button type="submit" size="sm">Add</Button>
              </form>
            </CardFooter>
            <p e:if={categoryDraft.error} class="error card-body">{categoryDraft.error}</p>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
