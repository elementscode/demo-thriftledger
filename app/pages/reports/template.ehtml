import "./style.css";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import {
  Account,
  Category,
  Transaction,
  UNCATEGORIZED,
  byCategoryId,
  currentMonth,
  dayLabel,
  formatMoney,
  formatWholeMoney,
  monthLabel,
  monthlyFlows,
  netWorthSeries,
  shiftMonth,
  spendingByCategory,
} from "#app/shared/lib/ledger";
import { compactMoney } from "./charts";
import type { ChartConfig } from "@elements/ui/chart";
import { AreaChart } from "@elements/ui/chart-area";
import { BarChart } from "@elements/ui/chart-bar";
import { PieChart } from "@elements/ui/chart-pie";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent, CardDescription, CardHeader, CardTitle } from "@elements/ui/card";
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "@elements/ui/collapsible";
import { Empty } from "@elements/ui/empty";
import { Icon } from "@elements/ui/icon";
import { Table, TableCell, TableHead } from "@elements/ui/table";

interface View {
  month: string;
}

interface Slice {
  id: string;
  name: string;
  color: string;
  cents: number;
  share: number;
}

const OTHER = "other";

const FLOWS: ChartConfig = {
  incomeCents: { label: "Income", color: "var(--series-1)" },
  spendingCents: { label: "Spending", color: "var(--series-2)" },
};

const NET_WORTH: ChartConfig = {
  cents: { label: "Net worth", color: "var(--series-1)" },
};

function lastSixMonths(): string[] {
  let now = currentMonth();
  return [-5, -4, -3, -2, -1, 0].map((by) => shiftMonth(now, by));
}

function onMonth(view: View, by: number) {
  view.month = shiftMonth(view.month, by);
  history.replaceState(null, "", view.month === currentMonth() ? "/reports" : `/reports?month=${view.month}`);
}

/**
 * The eight categories holding a chart color keep it; everything else,
 * uncategorized included, is one grey "Other" so no color is ever invented.
 */
export function slices(categories: LiveView<Category>, transactions: LiveView<Transaction>, month: string): Slice[] {
  let byId = byCategoryId(categories);
  let spent = spendingByCategory(transactions, byId, month);
  let rows: Slice[] = [];
  let other = 0;
  let total = 0;

  for (let [id, cents] of spent) {
    if (cents <= 0) {
      continue;
    }

    total += cents;

    let category = id === UNCATEGORIZED ? undefined : byId.get(id);

    if (category?.colorSlot) {
      rows.push({ id, name: category.name, color: `var(--series-${category.colorSlot})`, cents, share: 0 });
    } else {
      other += cents;
    }
  }

  rows.sort((a, b) => b.cents - a.cents);

  if (other > 0) {
    rows.push({ id: OTHER, name: "Other", color: "var(--series-other)", cents: other, share: 0 });
  }

  for (let row of rows) {
    row.share = row.cents / total;
  }

  return rows;
}

function sliceConfig(rows: Slice[]): ChartConfig {
  return Object.fromEntries(rows.map((r) => [r.id, { label: r.name, color: r.color }]));
}

function total(rows: Slice[]): number {
  return rows.reduce((sum, r) => sum + r.cents, 0);
}

function otherNames(categories: LiveView<Category>, transactions: LiveView<Transaction>, month: string): string {
  let byId = byCategoryId(categories);
  let names: string[] = [];

  for (let [id, cents] of spendingByCategory(transactions, byId, month)) {
    if (cents <= 0) {
      continue;
    }

    let category = id === UNCATEGORIZED ? undefined : byId.get(id);

    if (!category?.colorSlot) {
      names.push(category?.name ?? "Uncategorized");
    }
  }

  return names.sort().join(", ");
}

function flows(categories: LiveView<Category>, transactions: LiveView<Transaction>) {
  return monthlyFlows(transactions, byCategoryId(categories), lastSixMonths()).map((f) => ({
    ...f,
    label: monthLabel(f.month, "short"),
  }));
}

function netWorth(accounts: LiveView<Account>, transactions: LiveView<Transaction>) {
  let series = netWorthSeries(accounts, transactions);
  let first = series[0].cents;
  let last = series[series.length - 1].cents;

  let values = series.map((p) => p.cents);

  // The axis runs between whole $10K marks around the data, not from zero.
  let domain: [number, number] = [
    Math.floor(Math.min(...values) / 1_000_000) * 1_000_000,
    Math.ceil(Math.max(...values) / 1_000_000) * 1_000_000,
  ];

  return { points: series.map((p) => ({ ...p, label: dayLabel(p.day) })), first, last, domain };
}

<html lang="en" class="page-reports" (
  accounts: LiveView<Account>,
  categories: LiveView<Category>,
  transactions: LiveView<Transaction>,
  view: View,
)>
  <head>
    <title>Reports · thriftledger</title>
    <meta name="description" content="Spending by category, income against spending, and net worth.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="/reports" wide={true}>
      <div class="stack is-xl">
        <div class="reports-head row">
          <h1>Reports</h1>
        </div>

        <div class="reports-grid">
          <SpendingDonut {categories} {transactions} {view} />
          <FlowBars {categories} {transactions} />
        </div>

        <NetWorth {accounts} {transactions} />
      </div>
    </Layout>
  </body>
</html>

<SpendingDonut (
  categories: LiveView<Category>,
  transactions: LiveView<Transaction>,
  view: View,
  private hover: { index: number } = { index: -1 },
)>
  <Card class="chart-card">
    <CardHeader>
      <CardTitle level={2}>Spending by category</CardTitle>
      <CardAction>
        <div class="row is-sm">
          <Button variant="ghost" size="sm" icon label="Previous month" onclick={() => onMonth(view, -1)}>
            <Icon name="chevron-left" />
          </Button>
          <span class="chart-sub">{monthLabel(view.month)}</span>
          <Button variant="ghost" size="sm" icon label="Next month" onclick={() => onMonth(view, 1)}>
            <Icon name="chevron-right" />
          </Button>
        </div>
      </CardAction>
    </CardHeader>

    <CardContent class="stack is-lg">
      <div e:if={slices(categories, transactions, view.month).length > 0} class="donut-wrap">
        <PieChart class="donut"
                  data={slices(categories, transactions, view.month)}
                  config={sliceConfig(slices(categories, transactions, view.month))}
                  value="cents"
                  name="id"
                  innerRadius="68%"
                  outerRadius="100%"
                  startAngle={90}
                  endAngle={-270}
                  inactiveShape="dim"
                  active={hover.index}
                  centerValue={formatWholeMoney(total(slices(categories, transactions, view.month)))}
                  centerLabel="Spent"
                  label={`Spending in ${monthLabel(view.month)}`}
                  tooltip={{ hideLabel: true, formatter: (v) => formatWholeMoney(v as number) }} />

        <ul class="donut-legend">
          <li e:for={[i, s] of slices(categories, transactions, view.month).entries()}
              class={[hover.index === i && "is-hover"]}
              title={s.id === "other" ? otherNames(categories, transactions, view.month) : undefined}
              onmouseenter={() => hover.index = i}
              onmouseleave={() => hover.index = -1}>
            <span class="key" style={`background: ${s.color}`}></span>
            <span class="name">{s.name}</span>
            <span class="amount">{formatWholeMoney(s.cents)}</span>
            <span class="pct">{Math.round(s.share * 100)}%</span>
          </li>
        </ul>
      </div>

      <Empty e:else description={`No spending in ${monthLabel(view.month)}.`} />

      <p e:if={slices(categories, transactions, view.month).some((s) => s.id === "other")} class="hint">
        Other: {otherNames(categories, transactions, view.month)}.
      </p>
    </CardContent>
  </Card>
</SpendingDonut>

<FlowBars (
  categories: LiveView<Category>,
  transactions: LiveView<Transaction>,
)>
  <Card class="chart-card" title="Income and spending" level={2}>
    <CardContent class="stack is-md">
      <BarChart class="flow-chart"
                data={flows(categories, transactions)}
                config={FLOWS}
                x="label"
                legend={{ position: "top", align: "right" }}
                valueAxis={{ tickFormatter: (v) => compactMoney(v as number) }}
                label="Income and spending for the last six months"
                tooltip={{
                  labelFormatter: (_, row) => monthLabel(row.month as string),
                  formatter: (v) => formatMoney(v as number),
                  footerLabel: "Saved",
                  footer: (row) => formatMoney((row.incomeCents as number) - (row.spendingCents as number)),
                }} />

      <Collapsible class="report-table">
        <CollapsibleTrigger>
          <Button variant="link" size="sm"><Icon name="chevron-right" class="collapsible-chevron is-right" /> Show as a table</Button>
        </CollapsibleTrigger>
        <CollapsibleContent>
          <Table>
            <table>
              <thead>
                <tr>
                  <TableHead>Month</TableHead>
                  <TableHead align="end">Income</TableHead>
                  <TableHead align="end">Spending</TableHead>
                  <TableHead align="end">Saved</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={m of flows(categories, transactions)}>
                  <TableCell>{monthLabel(m.month)}</TableCell>
                  <TableCell align="end">{formatMoney(m.incomeCents)}</TableCell>
                  <TableCell align="end">{formatMoney(m.spendingCents)}</TableCell>
                  <TableCell align="end">{formatMoney(m.incomeCents - m.spendingCents)}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </CollapsibleContent>
      </Collapsible>
    </CardContent>
  </Card>
</FlowBars>

<NetWorth (
  accounts: LiveView<Account>,
  transactions: LiveView<Transaction>,
)>
  <Card class="chart-card">
    <CardHeader>
      <CardTitle level={2}>Net worth</CardTitle>
      <CardDescription>Every account, credit card debt subtracted</CardDescription>
      <CardAction>
        <div class="stack is-xs net-figure">
          <span class="hero-figure">{formatMoney(netWorth(accounts, transactions).last)}</span>
          <span class={["delta", netWorth(accounts, transactions).last >= netWorth(accounts, transactions).first ? "is-up" : "is-down"]}>
            {netWorth(accounts, transactions).last >= netWorth(accounts, transactions).first ? "▲" : "▼"}
            {formatMoney(Math.abs(netWorth(accounts, transactions).last - netWorth(accounts, transactions).first))} since {dayLabel(netWorth(accounts, transactions).points[0].day)}
          </span>
        </div>
      </CardAction>
    </CardHeader>

    <CardContent class="stack is-md">
      <AreaChart class="net-chart"
                 data={netWorth(accounts, transactions).points}
                 config={NET_WORTH}
                 x="label"
                 baseValue="dataMin"
                 valueAxis={{ tickFormatter: (v) => compactMoney(v as number), domain: netWorth(accounts, transactions).domain, tickCount: 5 }}
                 label="Net worth by week"
                 tooltip={{ formatter: (v) => formatMoney(v as number) }} />

      <Collapsible class="report-table">
        <CollapsibleTrigger>
          <Button variant="link" size="sm"><Icon name="chevron-right" class="collapsible-chevron is-right" /> Show as a table</Button>
        </CollapsibleTrigger>
        <CollapsibleContent>
          <Table>
            <table>
              <thead>
                <tr>
                  <TableHead>Week ending</TableHead>
                  <TableHead align="end">Net worth</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={p of netWorth(accounts, transactions).points}>
                  <TableCell>{dayLabel(p.day)}</TableCell>
                  <TableCell align="end">{formatMoney(p.cents)}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </CollapsibleContent>
      </Collapsible>
    </CardContent>
  </Card>
</NetWorth>
