import "./style.css";
import { LiveView, File } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Account, CsvMapping, ImportRecord, Transaction, dayLabel, formatMoney } from "#app/shared/lib/ledger";
import { CsvTable, ParsedRow, guessMapping, mapCsv, parseCsv } from "#app/shared/lib/csv";
import { ImportResult, importCsv } from "#app/shared/services/ledger";
import { Alert, AlertDescription } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { FileUpload } from "@elements/ui/file-upload";
import { Icon } from "@elements/ui/icon";
import { Label } from "@elements/ui/label";
import { NativeSelect } from "@elements/ui/native-select";
import { Table, TableHead, TableCell } from "@elements/ui/table";

export interface ImportState {
  accountId: string;
  fileName: string;
  text: string;
  table: CsvTable | null;
  mapping: CsvMapping;
  remembered: boolean;
  error: string;
  busy: boolean;
  result: ImportResult | null;
}

interface PreviewRow extends ParsedRow {
  id: string;
  duplicate: boolean;
}

interface Preview {
  rows: PreviewRow[];
  fresh: number;
  duplicates: number;
  errors: string[];
}

function rowKey(postedOn: string, amountCents: number, description: string): string {
  return `${postedOn}|${amountCents}|${description.trim().replace(/\s+/g, " ").toLowerCase()}`;
}

/**
 * The same rule the server applies: the nth repeat of a date, amount and
 * description is a duplicate when the account already holds n of them.
 */
export function preview(state: ImportState, transactions: LiveView<Transaction>): Preview {
  if (!state.table) {
    return { rows: [], fresh: 0, duplicates: 0, errors: [] };
  }

  let mapped = mapCsv(state.table, state.mapping);
  let existing = new Map<string, number>();

  for (let t of transactions) {
    if (t.accountId === state.accountId) {
      let key = rowKey(t.postedOn, t.amountCents, t.description);
      existing.set(key, (existing.get(key) ?? 0) + 1);
    }
  }

  let seen = new Map<string, number>();
  let duplicates = 0;

  let rows = mapped.rows.map((row, i) => {
    let key = rowKey(row.postedOn, row.amountCents, row.description);
    let n = (seen.get(key) ?? 0) + 1;
    seen.set(key, n);

    let duplicate = n <= (existing.get(key) ?? 0);

    if (duplicate) {
      duplicates++;
    }

    return { ...row, id: `r${i}`, duplicate };
  });

  return { rows, fresh: rows.length - duplicates, duplicates, errors: mapped.errors };
}

function applyRemembered(state: ImportState, accounts: LiveView<Account>) {
  let saved = accounts.get(state.accountId)?.csvMapping;
  let headers = state.table?.headers ?? [];

  if (saved && [saved.dateColumn, saved.descriptionColumn, saved.amountColumn].every((h) => headers.includes(h))) {
    state.mapping = { ...saved };
    state.remembered = true;
  } else {
    state.mapping = guessMapping(headers);
    state.remembered = false;
  }
}

function onFile(files: File[], state: ImportState, accounts: LiveView<Account>) {
  state.error = "";
  state.result = null;

  if (files.length === 0) {
    return;
  }

  let text = new TextDecoder().decode(files[0].data);
  let table = parseCsv(text);

  if (table.headers.length < 3 || table.rows.length === 0) {
    state.error = `${files[0].name} does not look like a CSV export with a header row.`;
    return;
  }

  state.fileName = files[0].name;
  state.text = text;
  state.table = table;
  applyRemembered(state, accounts);
}

function onAccount(state: ImportState, accounts: LiveView<Account>) {
  state.result = null;

  if (state.table) {
    applyRemembered(state, accounts);
  }
}

function onImport(state: ImportState) {
  state.busy = true;
  state.error = "";

  try {
    state.result = importCsv({
      accountId: state.accountId,
      fileName: state.fileName,
      text: state.text,
      mapping: state.mapping,
    });

    state.table = null;
    state.text = "";
  } catch (err: any) {
    state.error = err.message;
  }

  state.busy = false;
}

function onReset(state: ImportState) {
  state.table = null;
  state.text = "";
  state.fileName = "";
  state.error = "";
}

function accountLabel(accounts: LiveView<Account>, id: string): string {
  return accounts.get(id)?.name ?? "Deleted account";
}

function headerOptions(state: ImportState): { value: string; label: string }[] {
  return (state.table?.headers ?? []).map((h) => ({ value: h, label: h }));
}

function newestImports(imports: LiveView<ImportRecord>): ImportRecord[] {
  return imports.sort((a, b) => +new Date(b.createdAt) - +new Date(a.createdAt)).slice(0, 8);
}

<html lang="en" class="page-import" (
  accounts: LiveView<Account>,
  transactions: LiveView<Transaction>,
  imports: LiveView<ImportRecord>,
  initialAccountId: string,
  private state: ImportState = {
    accountId: initialAccountId || (accounts.at(0)?.id ?? ""),
    fileName: "",
    text: "",
    table: null,
    mapping: { dateColumn: "", descriptionColumn: "", amountColumn: "", invertAmounts: false },
    remembered: false,
    error: "",
    busy: false,
    result: null,
  },
)>
  <head>
    <title>Import · thriftledger</title>
    <meta name="description" content="Import transactions from a bank CSV export.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="/import">
      <div class="stack is-xl">
        <div class="stack is-xs">
          <h1>Import</h1>
          <p class="lede">Bring in a CSV export from your bank. Map its columns once per account; rows already in the ledger are skipped.</p>
        </div>

        <div class="import-grid">
          <div class="stack is-lg">
            <Alert e:if={state.result}
                   variant="success"
                   role="status"
                   title={`Added ${state.result!.added} ${state.result!.added === 1 ? "transaction" : "transactions"} to ${accountLabel(accounts, state.accountId)}`}>
              <Icon name="check-circle" />
              <AlertDescription class="stack is-sm">
                <p>
                  {state.result!.skipped} already in the ledger were skipped.
                  {state.result!.categorized} were categorized by your rules{state.result!.added - state.result!.categorized > 0 ? `; ${state.result!.added - state.result!.categorized} are waiting for a category` : ""}.
                </p>
                <span class="cluster is-sm">
                  <Button size="sm" href="/transactions?show=uncategorized" e:if={state.result!.added > state.result!.categorized}>Categorize them</Button>
                  <Button size="sm" variant="ghost" href="/">See the budget</Button>
                </span>
              </AlertDescription>
            </Alert>

            <Card>
              <CardContent class="stack is-lg">
                <div class="step-title row">
                  <span class="step-num">1</span>
                  <h2>Account and file</h2>
                </div>

                <Field label="Import into"
                       reserveError={false}
                       description={accounts.get(state.accountId)?.csvMapping ? "This account's column mapping is saved from its last import." : "First import for this account: you'll map its columns below."}>
                  <NativeSelect block
                                value={state.accountId}
                                onchange={() => onAccount(state, accounts)}
                                options={accounts.map((a) => ({ value: a.id, label: `${a.name}${a.institution ? ` · ${a.institution}` : ""}` }))} />
                </Field>

                <FileUpload e:if={!state.table}
                            accept=".csv,text/csv"
                            hint={`Most banks offer one under "download transactions".`}
                            onFileAccept={(d) => onFile(d.files, state, accounts)}>
                  <span slot="trigger">Browse files</span>
                  <div slot="dropzone" class="stack is-xs import-drop">
                    <Icon name="upload" size={28} />
                    <strong>Choose a CSV file</strong>
                  </div>
                </FileUpload>

                <div e:else class="row is-sm">
                  <Badge variant="outline">{state.fileName}</Badge>
                  <span class="hint">{state.table!.rows.length} rows</span>
                  <Button variant="ghost" size="sm" onclick={() => onReset(state)}>Choose another file</Button>
                </div>

                <p e:if={state.error} class="error" role="alert">{state.error}</p>
              </CardContent>
            </Card>

            <Card e:if={state.table}>
              <CardContent class="stack is-lg">
                <div class="step-title row">
                  <span class="step-num">2</span>
                  <h2>Columns</h2>
                  <Badge e:if={state.remembered} variant="success">Saved mapping</Badge>
                </div>

                <div class="mapping">
                  <Field label="Date" reserveError={false}>
                    <NativeSelect block value={state.mapping.dateColumn} options={headerOptions(state)} />
                  </Field>

                  <Field label="Description" reserveError={false}>
                    <NativeSelect block value={state.mapping.descriptionColumn} options={headerOptions(state)} />
                  </Field>

                  <Field label="Amount" reserveError={false}>
                    <NativeSelect block value={state.mapping.amountColumn} options={headerOptions(state)} />
                  </Field>
                </div>

                <Label>
                  <Checkbox checked={state.mapping.invertAmounts} />
                  This export shows purchases as positive amounts
                </Label>
              </CardContent>
            </Card>

            <Card e:if={state.table}>
              <CardContent class="stack is-lg">
                <div class="step-title row">
                  <span class="step-num">3</span>
                  <h2>Review</h2>
                </div>

                <div class="counts cluster">
                  <Badge variant="accent">{preview(state, transactions).fresh} new</Badge>
                  <Badge variant="outline">{preview(state, transactions).duplicates} already imported</Badge>
                  <Badge e:if={preview(state, transactions).errors.length > 0} variant="warning">{preview(state, transactions).errors.length} unreadable</Badge>
                </div>

                <Table label="Preview" class="preview">
                  <table>
                    <thead>
                      <tr>
                        <TableHead>Date</TableHead>
                        <TableHead>Description</TableHead>
                        <TableHead align="end">Amount</TableHead>
                        <TableHead><span class="visually-hidden">Status</span></TableHead>
                      </tr>
                    </thead>
                    <tbody>
                      <tr e:for={row of preview(state, transactions).rows.slice(0, 8)} class={[row.duplicate && "is-dupe"]}>
                        <TableCell>{dayLabel(row.postedOn)}</TableCell>
                        <TableCell>{row.description}</TableCell>
                        <TableCell align="end">{formatMoney(row.amountCents)}</TableCell>
                        <TableCell><span e:if={row.duplicate} class="hint">skip</span></TableCell>
                      </tr>
                    </tbody>
                  </table>
                </Table>

                <p e:if={preview(state, transactions).rows.length > 8} class="hint">and {preview(state, transactions).rows.length - 8} more</p>

                <ul e:if={preview(state, transactions).errors.length > 0} class="errors error">
                  <li e:for={line of preview(state, transactions).errors.slice(0, 5).map((text, i) => ({ id: String(i), text }))}>{line.text}</li>
                </ul>

                <div class="row">
                  <Button variant="primary"
                          loading={state.busy}
                          disabled={preview(state, transactions).fresh === 0}
                          onclick={() => onImport(state)}>
                    Import {preview(state, transactions).fresh} {preview(state, transactions).fresh === 1 ? "transaction" : "transactions"}
                  </Button>
                </div>
              </CardContent>
            </Card>
          </div>

          <aside class="stack is-lg">
            <Card title="Try it" level={2}>
              <CardContent class="stack is-sm">
                <p>Download a sample export from the Cashback Card: two weeks you already have and six new purchases.</p>
                <Button size="sm" href="/import/sample.csv" attrs={{ download: true }}>Download sample CSV</Button>
              </CardContent>
            </Card>

            <Card title="Recent imports" level={2}>
              <CardContent>
                <ul class="history" e:if={imports.length > 0}>
                  <li e:for={record of newestImports(imports)}>
                    <strong>{record.fileName}</strong>
                    <span>{accountLabel(accounts, record.accountId)} · {record.addedCount} added, {record.skippedCount} skipped · {new Date(record.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
                  </li>
                </ul>
                <Empty e:else description="Nothing imported yet." />
              </CardContent>
            </Card>
          </aside>
        </div>
      </div>
    </Layout>
  </body>
</html>
