import "./style.css";
import { redirect } from "@elements/app";
import { signin, DEMO_LOGIN } from "#app/shared/services/auth";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

const POINTS = [
  { id: "import", text: "Import any bank's CSV export. Duplicates are skipped." },
  { id: "rules", text: "Rules categorize transactions as they arrive." },
  { id: "budget", text: "Budgets and reports move the moment anything changes." },
];

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onUseDemo(form: SigninForm) {
  form.email = DEMO_LOGIN.email;
  form.password = DEMO_LOGIN.password;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · thriftledger</title>
    <meta name="description" content="Sign in to thriftledger, a personal budget.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="signin-main">
      <aside class="signin-aside">
        <div class="signin-brand row">
          <span class="signin-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 12.5 L6.5 8 L9.5 10.5 L13 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          thriftledger
        </div>

        <div class="signin-pitch stack is-md">
          <h1>Know where every dollar went.</h1>
          <p class="lede">Your accounts, your categories and a monthly budget, in one ledger that keeps itself current.</p>
        </div>

        <ul class="signin-points stack is-sm">
          <li e:for={point of POINTS} class="row is-start">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8.5 L6.5 11.5 L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {point.text}
          </li>
        </ul>
      </aside>

      <div class="signin-panel">
        <form class="signin-form stack is-lg" onsubmit={() => onSubmit(form)}>
          <div class="stack is-xs">
            <h2>Sign in</h2>
            <p class="hint">Welcome back.</p>
          </div>

          <div class="callout is-accent signin-demo">
            <div class="callout-title">Demo account</div>
            <div class="callout-body">
              <dl>
                <dt>Email</dt>
                <dd>{DEMO_LOGIN.email}</dd>
                <dt>Password</dt>
                <dd>{DEMO_LOGIN.password}</dd>
              </dl>
              <button type="button" class="is-sm" disabled={form.busy} onclick={() => onUseDemo(form)}>Sign in as Maya</button>
            </div>
          </div>

          <p e:if={form.error} class="error" role="alert">{form.error}</p>

          <div class="field">
            <label for="email">Email</label>
            <input id="email"
                   name="email"
                   type="email"
                   value={form.email}
                   autocomplete="email"
                   autocapitalize="none"
                   spellcheck={false}
                   placeholder="you@example.com"
                   required>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password"
                   name="password"
                   type="password"
                   value={form.password}
                   autocomplete="current-password"
                   required>
          </div>

          <button type="submit" class={["is-primary", "is-block", form.busy && "is-loading"]} disabled={form.busy}>Sign in</button>
        </form>
      </div>
    </main>
  </body>
</html>
