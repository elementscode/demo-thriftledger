import "./style.css";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import {
  ACCOUNT_KINDS,
  Account,
  AccountKind,
  Category,
  Transaction,
  accountBalance,
  dayLabel,
  formatMoney,
  parseMoneyInput,
} from "#app/shared/lib/ledger";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { Empty } from "@elements/ui/empty";
import { Icon } from "@elements/ui/icon";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";

interface Draft {
  name: string;
  kind: AccountKind;
  institution: string;
  opening: string;
  error: string;
}

function blankDraft(): Draft {
  return { name: "", kind: "checking", institution: "", opening: "", error: "" };
}

function kindLabel(kind: AccountKind): string {
  return ACCOUNT_KINDS.find((k) => k.kind === kind)?.label ?? kind;
}

function activity(account: Account, transactions: LiveView<Transaction>): { count: number; last: string } {
  let count = 0;
  let last = "";

  for (let t of transactions) {
    if (t.accountId === account.id) {
      count++;

      if (t.postedOn > last) {
        last = t.postedOn;
      }
    }
  }

  return { count, last };
}

export function summary(accounts: LiveView<Account>, transactions: LiveView<Transaction>) {
  let assets = 0;
  let debts = 0;

  for (let a of accounts) {
    let balance = accountBalance(a, transactions);

    if (balance >= 0) {
      assets += balance;
    } else {
      debts -= balance;
    }
  }

  return { assets, debts, net: assets - debts };
}

function ordered(accounts: LiveView<Account>): Account[] {
  let rank = { checking: 0, savings: 1, credit: 2 };
  return accounts.sort((a, b) => rank[a.kind] - rank[b.kind] || a.name.localeCompare(b.name));
}

function onAdd(accounts: LiveView<Account>, draft: Draft) {
  let opening = draft.opening.trim() === "" ? 0 : parseMoneyInput(draft.opening);

  if (draft.name.trim() === "") {
    draft.error = "give the account a name";
    return;
  }

  if (Number.isNaN(opening)) {
    draft.error = "the starting balance is not an amount";
    return;
  }

  // A card's balance is what is owed, so it counts against net worth.
  if (draft.kind === "credit") {
    opening = -Math.abs(opening);
  }

  try {
    accounts.insert(
      {
        name: draft.name.trim(),
        kind: draft.kind,
        institution: draft.institution.trim(),
        openingBalanceCents: opening,
        csvMapping: null,
        createdAt: new Date(),
      },
      () => Object.assign(draft, blankDraft()),
    );
  } catch (err: any) {
    draft.error = err.message;
  }
}

function deleteMessage(account: Account, count: number): string {
  return count > 0 ? `Its ${count} transactions are deleted with it. This cannot be undone.` : "";
}

<html lang="en" class="page-accounts" (
  accounts: LiveView<Account>,
  categories: LiveView<Category>,
  transactions: LiveView<Transaction>,
  private draft: Draft = blankDraft(),
)>
  <head>
    <title>Accounts · thriftledger</title>
    <meta name="description" content="Your bank accounts and cards.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="/accounts">
      <div class="stack is-xl">
        <h1>Accounts</h1>

        <div class="acct-summary">
          <div class="card stack is-xs">
            <span class="acct-label">Net worth</span>
            <span class="acct-value">{formatMoney(summary(accounts, transactions).net)}</span>
          </div>
          <div class="card stack is-xs">
            <span class="acct-label">Cash</span>
            <span class="acct-value">{formatMoney(summary(accounts, transactions).assets)}</span>
          </div>
          <div class="card stack is-xs">
            <span class="acct-label">Owed</span>
            <span class="acct-value">{formatMoney(summary(accounts, transactions).debts)}</span>
          </div>
        </div>

        <section class="card">
          <ul class="acct-list" e:if={accounts.length > 0}>
            <li e:for={account of ordered(accounts)} class="acct-row">
              <span class={["acct-icon", account.kind === "credit" && "is-credit"]} aria-hidden="true">
                <svg e:if={account.kind === "credit"} width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10 H21" stroke="currentColor" stroke-width="1.8"/><path d="M7 15 H10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <svg e:elseif={account.kind === "savings"} width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3 L20 7 V8 H4 V7 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 10 V17 M10 10 V17 M14 10 V17 M18 10 V17 M3.5 20 H20.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <svg e:else width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
              </span>

              <div class="acct-name">
                <strong>{account.name}</strong>
                <small>
                  {kindLabel(account.kind)}{account.institution ? ` · ${account.institution}` : ""}
                  · {activity(account, transactions).count} transactions{activity(account, transactions).last ? `, latest ${dayLabel(activity(account, transactions).last)}` : ""}
                </small>
              </div>

              <div class="acct-balance">
                <strong>{formatMoney(account.kind === "credit" ? -accountBalance(account, transactions) : accountBalance(account, transactions))}</strong>
                <small>{account.kind === "credit" ? "owed" : "balance"}</small>
              </div>

              <div class="acct-actions row">
                <Button size="sm" href={`/import?account=${account.id}`}>Import</Button>
                <Button size="sm" variant="ghost" href={`/transactions?account=${account.id}`}>Transactions</Button>
                <AlertDialog title={`Delete ${account.name}?`} description={deleteMessage(account, activity(account, transactions).count)}>
                  <Button slot="trigger" variant="ghost" size="sm" icon label={`Delete ${account.name}`}>
                    <Icon name="trash" />
                  </Button>
                  <AlertDialogFooter>
                    <AlertDialogCancel>Cancel</AlertDialogCancel>
                    <AlertDialogAction variant="danger" onclick={() => accounts.delete(account)}>Delete</AlertDialogAction>
                  </AlertDialogFooter>
                </AlertDialog>
              </div>
            </li>
          </ul>

          <Empty e:else description="No accounts yet. Add one below." />
        </section>

        <Card title="Add an account" level={2}>
          <CardContent>
            <form class="stack is-md" onsubmit={() => onAdd(accounts, draft)}>
              <div class="acct-form">
                <Field label="Name" reserveError={false}>
                  <Input value={draft.name} placeholder="Joint Checking" required />
                </Field>

                <Field label="Type" reserveError={false}>
                  <NativeSelect block value={draft.kind} options={ACCOUNT_KINDS.map((k) => ({ value: k.kind, label: k.label }))} />
                </Field>

                <Field label="Bank" reserveError={false}>
                  <Input value={draft.institution} placeholder="Harborline Credit Union" />
                </Field>

                <Field label={draft.kind === "credit" ? "Balance owed" : "Starting balance"} reserveError={false}>
                  <Input value={draft.opening} placeholder="0.00" attrs={{ inputmode: "decimal" }} />
                </Field>
              </div>

              <p e:if={draft.error} class="error">{draft.error}</p>

              <div class="acct-form-foot row">
                <span class="hint">Then import its transactions from a CSV export.</span>
                <Button type="submit" variant="primary">Add account</Button>
              </div>
            </form>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
